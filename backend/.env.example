# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection strings (e.g. from Neon.tech). Use sslmode=verify-full,
# not require/prefer — pg will alias those to verify-full anyway today, but
# that will stop happening in a future major version (see pg's own warning).
# DATABASE_URL is the pooled endpoint ("-pooler" in a Neon hostname) — used by
# the app's own runtime queries (docs/architecture.md §5.1). DIRECT_URL is the
# same database via the direct/unpooled endpoint — used only by the Prisma
# CLI (migrate, studio), since DDL/advisory locks aren't reliable under
# transaction-mode pooling. If your provider doesn't offer a separate pooled
# endpoint, both can point at the same connection string.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# JWT signing secret for access tokens — generate a long random value, never reuse across environments
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN="30d"

# HMAC keys — each used for a single purpose, generate separate long random values, never reuse across environments
PHONE_HASH_SECRET="change-me"
OTP_CODE_HASH_SECRET="change-me"
REFRESH_TOKEN_HASH_SECRET="change-me"

# OTP settings
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_PHONE_PER_HOUR=5
OTP_REQUEST_LIMIT_PER_IP_PER_HOUR=20
# Must be "false" in every real environment — e2e test runs override this via
# test/jest-e2e.setup.ts; refused at boot if NODE_ENV=production.
OTP_RATE_LIMIT_BYPASS=false

# Feature 14 (frontend), FR-223: same test-only-escape-hatch shape as
# OTP_RATE_LIMIT_BYPASS above — must be "false" in every real environment.
AUTH_OTP_DEBUG_ECHO=false

# Feature 14 (frontend), FR-205: the one browser origin CORS allows.
FRONTEND_ORIGIN="http://localhost:3001"

# Liveness settings
LIVENESS_SESSION_LIMIT_PER_HOUR=5

# Must match the policy version shown to the user on the consent screen (product.md §7.1)
PRIVACY_POLICY_VERSION="v1"

# Profile photo settings
PROFILE_MAX_PHOTOS=6
PROFILE_MAX_UPLOAD_BYTES=8388608

# Real S3-compatible object storage (Feature 7, docs/requirements.md FR-90) —
# works unchanged against any S3-compatible endpoint. Dev/test: a local MinIO
# server (docs/architecture.md has setup notes). Production: point these at a
# real vendor (Cloudflare R2, AWS S3, Backblaze B2, etc., EU region for data
# residency) — no code change, only these values differ.
STORAGE_ENDPOINT="http://127.0.0.1:9010"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="change-me"
STORAGE_ACCESS_KEY_ID="change-me"
STORAGE_SECRET_ACCESS_KEY="change-me"
# 'true' for MinIO and most non-AWS S3-compatible vendors (path-style bucket
# addressing); 'false' for real AWS S3 (virtual-hosted-style).
STORAGE_FORCE_PATH_STYLE="true"
# Presigned URL lifetime — never a permanent public link (FR-89).
PHOTO_URL_EXPIRY_SECONDS=900

# clamd daemon (real malware scanning — see docs/roadmap.md §4 for setup notes;
# run it as its own service/sidecar in production, not on the API host)
CLAMD_HOST="127.0.0.1"
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=15000

# FR-50: swipe-velocity abuse guard (product.md §5 risk-engine signal)
SWIPE_RATE_LIMIT_PER_MINUTE=60
# FR-57: message-send abuse guard, same pattern
MESSAGE_RATE_LIMIT_PER_MINUTE=60

# Real content moderation (Feature 8, docs/requirements.md FR-96) — OpenAI
# Moderation API, omni-moderation-latest model, used for both text and image.
OPENAI_API_KEY="change-me"
MODERATION_TIMEOUT_MS=15000

# AI Prompt Search (Feature 9, docs/requirements.md) — OpenAI for extraction,
# embeddings, and Whisper. Voice rate limit is stricter (Whisper billed
# separately). AI_SEARCH_MAX_AUDIO_BYTES is a deliberate file-size proxy for
# duration, not exact decoded duration (Open Items #4).
AI_SEARCH_TEXT_RATE_LIMIT_PER_MINUTE=10
AI_SEARCH_VOICE_RATE_LIMIT_PER_MINUTE=3
AI_SEARCH_MAX_AUDIO_BYTES=5242880
AI_SEARCH_TIMEOUT_MS=15000

# Shared transcription provider (common/ai/) — used by Feature 9 (voice
# search) and Feature 11 (voice turns), so it has its own timeout config.
AI_TRANSCRIPTION_TIMEOUT_MS=15000

# Feature 10: Super Like explanation / "Why You Two?" / Smart Boost.
# BOOST_DURATION_MINUTES and BOOST_RATE_LIMIT_PER_DAY are placeholders
# (docs/requirements.md Feature 10, Open Items #4), not data-driven figures.
MATCH_EXPLANATION_TIMEOUT_MS=15000
BOOST_DURATION_MINUTES=30
BOOST_RATE_LIMIT_PER_DAY=1

# Feature 11: Conversational (text+voice) Profile Setup. All placeholders
# (docs/requirements.md Feature 11, Open Items #6), tunable without a code change.
CONVERSATIONAL_SETUP_SESSION_TTL_MINUTES=30
CONVERSATIONAL_SETUP_MAX_TURNS=20
CONVERSATIONAL_SETUP_TIMEOUT_MS=15000
CONVERSATIONAL_SETUP_SESSION_START_RATE_LIMIT_PER_HOUR=10
CONVERSATIONAL_SETUP_TEXT_TURN_RATE_LIMIT_PER_MINUTE=15
CONVERSATIONAL_SETUP_VOICE_TURN_RATE_LIMIT_PER_MINUTE=5
CONVERSATIONAL_SETUP_MAX_AUDIO_BYTES=5242880

# Feature 12: Share My Date. DATE_SHARE_LINK_BUFFER_HOURS anchors expiresAt to
# the date's own datetime, not creation time (docs/requirements.md Feature 12,
# Open Items #2). Rate-limit figures are placeholders (Open Items #4).
DATE_SHARE_TOKEN_HASH_SECRET=replace-with-a-real-random-secret
DATE_SHARE_LINK_BUFFER_HOURS=24
DATE_SHARE_LINK_RATE_LIMIT_PER_DAY=10
DATE_SHARE_LOOKUP_RATE_LIMIT_PER_IP_PER_MINUTE=100

# Redis — WebSocket pub/sub adapter for the chat gateway (product.md §8.4);
# also backs Feature 11's ephemeral conversational-setup session store under
# a separate key prefix (requirements.md Feature 11 Open Items #2).
# Use rediss:// (TLS) for a managed provider like Upstash, not redis://.
REDIS_URL="rediss://default:password@host:6379"

# Feature 13: Voice/Video Calling — Cloudflare Realtime TURN. Server-side
# only — used to mint short-lived per-call ICE-server credentials via
# Cloudflare's generate-ice-servers API, never sent to a client directly.
CLOUDFLARE_TURN_KEY_ID=change-me
CLOUDFLARE_TURN_API_TOKEN=change-me
CLOUDFLARE_TURN_CREDENTIAL_TTL_SECONDS=3600
FIRST_CALL_DURATION_LIMIT_SECONDS=300
CALL_RINGING_TIMEOUT_SECONDS=60
CALL_START_RATE_LIMIT_PER_HOUR=20

# Real gap closed (2026-09-18 audit): reports had no dedicated rate limit.
REPORT_RATE_LIMIT_PER_HOUR=10

# Feature 21: AI Matching Foundation — feature kill switches (FR-300/301).
# All default "true" so behavior is unchanged unless an operator explicitly
# flips one off.
AI_SEARCH_ENABLED=true
AI_ONBOARDING_ENABLED=true
VOICE_CALLS_ENABLED=true
VIDEO_CALLS_ENABLED=true
PUBLIC_SAFETY_SHARE_ENABLED=true

PORT=3000
