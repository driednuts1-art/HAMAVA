{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 60000,
  "maxWorkers": 1,
  "globalSetup": "<rootDir>/jest-e2e.global-setup.ts",
  "setupFiles": ["<rootDir>/jest-e2e.setup.ts"]
}
